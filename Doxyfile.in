# Project Information
PROJECT_NAME           = "libparallelproj"
PROJECT_NUMBER         = @PROJECT_VERSION@
OUTPUT_DIRECTORY       = @DOXYGEN_OUTPUT_DIR@
INPUT                  = @CMAKE_SOURCE_DIR@/include/parallelproj.h
RECURSIVE              = NO

# Build Settings
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_XML           = YES
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
HIDE_UNDOC_MEMBERS     = YES
FULL_PATH_NAMES        = NO
STRIP_FROM_PATH        = include

# Preprocessing
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
JAVADOC_AUTOBRIEF      = YES

# Reusable documentation snippets (used in include/parallelproj.h)
ALIASES                += pp_note_pointer_types="@note All pointers can be host pointers, CUDA device pointers, or CUDA managed pointers."
ALIASES                += pp_note_image_layout="@note Image memory layout for @p image is C-contiguous with index n1*n2*i + n2*j + k for voxel/pixel [i,j,k]."
ALIASES                += pp_note_tof_sino_layout="@note TOF sinogram memory layout for @p projection_values is row-major per LOR:^^[LOR0-TOFBIN-0, LOR0-TOFBIN-1, ..., LOR0-TOFBIN-(@p num_tof_bins-1),^^ LOR1-TOFBIN-0, LOR1-TOFBIN-1, ..., LOR1-TOFBIN-(@p num_tof_bins-1), ...]."
ALIASES                += pp_param_lor_start{1}="@param lor_start Pointer to array of shape [3 * @p \1] with the coordinates of the start points of the LORs/events.^^The start coordinates of the n-th LOR/event are at @p lor_start[n*3 + i] with i = 0,1,2.^^Units are those of @p voxel_size."
ALIASES                += pp_param_lor_end{1}="@param lor_end Pointer to array of shape [3 * @p \1] with the coordinates of the end points of the LORs/events.^^The end coordinates of the n-th LOR/event are at @p lor_end[n*3 + i] with i = 0,1,2.^^Units are those of @p voxel_size."
ALIASES                += pp_param_image_fwd="@param image Pointer to array of shape [n0*n1*n2] containing the 3D image used for forward projection."
ALIASES                += pp_param_image_back="@param image Pointer to array of shape [n0*n1*n2] containing the 3D image used for backprojection.^^Values are added to the existing contents of this array."
ALIASES                += pp_param_image_origin="@param image_origin Pointer to array [x0_0, x0_1, x0_2] of coordinates of the center of the [0,0,0] voxel."
ALIASES                += pp_param_voxel_size="@param voxel_size Pointer to array [vs0, vs1, vs2] of voxel sizes."
ALIASES                += pp_param_count{2}="@param \1 Number of \2."
ALIASES                += pp_param_projection_values_fwd{1}="@param projection_values Pointer to array of length @p \1 where the forward projection results will be stored."
ALIASES                += pp_param_projection_values_back{1}="@param projection_values Pointer to array of length @p \1 with the values to be backprojected."
ALIASES                += pp_param_projection_values_tof_sino_out{2}="@param projection_values Pointer to array of length @p \1 * @p \2 (output) used to store the projections."
ALIASES                += pp_param_projection_values_tof_sino_in{2}="@param projection_values Pointer to TOF sinogram data of length @p \1 * @p \2 (see details)."
ALIASES                += pp_param_projection_values_tof_lm_out{1}="@param projection_values Pointer to array of length @p \1 (output) used to store the projections."
ALIASES                += pp_param_projection_values_tof_lm_back{1}="@param projection_values Pointer to array of values to be backprojected (length @p \1)."
ALIASES                += pp_param_image_dim="@param image_dim Pointer to array with image dimensions [n0, n1, n2]."
ALIASES                += pp_param_tof_image_dim="@param image_dim Pointer to array with image dimensions [n0, n1, n2]."
ALIASES                += pp_param_tof_bin_width="@param tof_bin_width Width of the TOF bins in spatial units (units of @p lor_start and @p lor_end)."
ALIASES                += pp_param_tof_sigma{2}="@param tof_sigma Pointer to array of length 1 or @p \1 (depending on @p \2).^^Contains TOF resolution (sigma) values in spatial units (units of @p lor_start and @p lor_end)."
ALIASES                += pp_param_tof_center_offset{2}="@param tof_center_offset Pointer to array of length 1 or @p \1 (depending on @p \2).^^Contains offsets of the central TOF bin from the LOR midpoint in spatial units.^^A positive value means a shift towards the end point of the LOR."
ALIASES                += pp_param_tof_num_sigmas="@param num_sigmas Half width of the truncated Gaussian TOF kernel in units of the TOF sigma.^^The kernel is zero beyond num_sigmas * sigma from the TOF position; the weight of a TOF bin is the integral of the truncated kernel over the bin, normalized such that the weights of all bins overlapping the support sum to 1 (sum over all TOF bins = non-TOF projection if the TOF bins cover the support).^^TOF windows wider than 64 TOF bins are truncated to 64 bins centered on the TOF position and renormalized."
ALIASES                += pp_param_tof_num_bins="@param num_tof_bins Number of TOF bins."
ALIASES                += pp_note_tof_kernel_table="@note Tabulated TOF kernel: @p tof_kernel_cdf holds the cumulative TOF kernel F(u) at @p tof_kernel_num_samples uniformly spaced points from @p tof_kernel_u_min to @p tof_kernel_u_max (table[k] = F(u_min + k * (u_max - u_min) / (num_samples - 1))).^^u is the distance along the LOR between the TOF position and the true annihilation point in spatial units (units of @p lor_start and @p lor_end), positive towards the end point of the LOR. For an arrival time difference dt = t(start detector) - t(end detector), u = c dt / 2 (about 0.1499 mm per ps).^^[u_min, u_max] is the support of the kernel (F is constant outside). F must not decrease and F(u_max) > F(u_min); it is normalized by F(u_max) - F(u_min). F is interpolated linearly between the table points.^^The weight of a TOF bin is F_s(upper bin edge - x) - F_s(lower bin edge - x) (normalized), with x the TOF position and F_s(u) = F(u / s) the kernel scaled by @p tof_kernel_scale s (s = 1: kernel as tabulated, s = 1.5: same shape, 50 % wider). The TOF bin width is NOT part of the table: the projector integrates the kernel over each TOF bin."
ALIASES                += pp_param_tof_kernel_cdf="@param tof_kernel_cdf Pointer to array of length @p tof_kernel_num_samples with the cumulative TOF kernel F (see the note on the tabulated TOF kernel)."
ALIASES                += pp_param_tof_kernel_num_samples="@param tof_kernel_num_samples Number of table points (>= 2)."
ALIASES                += pp_param_tof_kernel_u_min="@param tof_kernel_u_min Position of the first table point (start of the kernel support) in spatial units."
ALIASES                += pp_param_tof_kernel_u_max="@param tof_kernel_u_max Position of the last table point (end of the kernel support) in spatial units (> tof_kernel_u_min)."
ALIASES                += pp_param_tof_kernel_scale{2}="@param tof_kernel_scale Pointer to array of length 1 or @p \1 (depending on @p \2) with the scale s > 0 of the tabulated kernel: F_s(u) = F(u / s), i.e. s > 1 makes the kernel wider (same shape). Scaling is around u = 0 (the true position); the TOF center offset is not scaled."
ALIASES                += pp_param_tof_dep_kernel_scale{1}="@param is_lor_dependent_tof_kernel_scale Unsigned char 0 or 1.^^0 means that the first value in @p tof_kernel_scale is used for all \1.^^1 (non-zero) means that the kernel scales are LOR / event dependent."
ALIASES                += pp_param_tof_bin_index{1}="@param tof_bin_index Pointer to array of length @p \1 with the TOF bin numbers."
ALIASES                += pp_param_tof_dep_sigma{1}="@param is_lor_dependent_tof_sigma Unsigned char 0 or 1.^^0 means that the first value in @p tof_sigma is used for all \1.^^1 (non-zero) means that the TOF resolutions are LOR dependent."
ALIASES                += pp_param_tof_dep_center{1}="@param is_lor_dependent_tof_center_offset Unsigned char 0 or 1.^^0 means that the first value in @p tof_center_offset is used for all \1.^^1 (non-zero) means that the TOF center offsets are LOR dependent."
ALIASES                += pp_param_device_id="@param device_id ID of the CUDA device to use for computation (default: 0). A negative value uses the current CUDA device. The caller's current CUDA device is restored before the function returns. Ignored in builds without CUDA."
ALIASES                += pp_param_threads="@param threads_per_block Number of threads per block for GPU computation (default: 64)."
ALIASES                += pp_param_stream="@param stream CUDA stream (a cudaStream_t, passed as void*) for this call. nullptr (default): the call runs on the legacy default stream and is synchronous, i.e. it waits for that stream (not for the whole device) before returning. Any other stream (including cudaStreamLegacy / cudaStreamPerThread): all copies and the kernel are queued on that stream and, for device / managed arrays, the call returns without waiting. Calls with host arrays always wait for their stream before returning. Ignored in builds without CUDA."

# HTML Output
HTML_OUTPUT            = html

GENERATE_TREEVIEW      = YES # optional. Also works without treeview
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
HTML_COLORSTYLE        = LIGHT # required with Doxygen >= 1.9.5

# Markdown support
MARKDOWN_SUPPORT       = YES
